{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"description":"A project checkpoint grouping related tasks. Simplified forward-only lifecycle; milestones do not require evidence.","properties":{"created_at":{"description":"UTC ISO-8601 timestamp of creation.","format":"date-time","type":"string"},"description":{"description":"What this milestone marks.","type":["string","null"]},"due_date":{"description":"Due date as YYYY-MM-DD.","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":["string","null"]},"id":{"description":"Unique identifier (uuid hex).","minLength":1,"type":"string"},"name":{"description":"Milestone name.","minLength":1,"type":"string"},"project_id":{"description":"Project this milestone belongs to.","minLength":1,"type":"string"},"status":{"description":"Milestone status. Forward-only: Proposed -> Assigned -> In Progress -> Completed.","enum":["Proposed","Assigned","In Progress","Completed"],"type":"string"}},"required":["id","project_id","name","status"],"title":"Milestone","type":"object"}